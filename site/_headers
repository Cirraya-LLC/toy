# Cloudflare Pages header config. The index is fetched by the client, so for it these lines
# are functionality, not optimisation.
/index.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  # Kept short: an index update should not take a day to take effect.
  Cache-Control: public, max-age=300

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
